  dialogueText: {fileID: 277741176}
  dialogueLines:
  - speakerName: clown
    portrait: {fileID: 21300000, guid: a92bb00613b024542ba7d490c6cf22ba, type: 3}
    dialogue: 'Welcome back your majesty! '
  - speakerName: clown
    portrait: {fileID: 21300000, guid: a92bb00613b024542ba7d490c6cf22ba, type: 3}
    dialogue: We have a lot of audience members today.
  - speakerName: clown
    portrait: {fileID: 21300000, guid: a92bb00613b024542ba7d490c6cf22ba, type: 3}
    dialogue: 'They''re all seated in  the show room. '
  - speakerName: clown
    portrait: {fileID: 21300000, guid: a92bb00613b024542ba7d490c6cf22ba, type: 3}
    dialogue: 'Let''s go find our first member. '
  - speakerName: clown
    portrait: {fileID: 21300000, guid: a92bb00613b024542ba7d490c6cf22ba, type: 3}
    dialogue: Look around for any clues!
  autoStartDialogue: 1
  typingSpeed: 0.03
