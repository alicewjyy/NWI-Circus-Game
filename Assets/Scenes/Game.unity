  dialogueLines:
  - speakerName: clown
    portrait: {fileID: 21300000, guid: a92bb00613b024542ba7d490c6cf22ba, type: 3}
    dialogue: 'Welcome back your majesty! '
    hasChoices: 0
    choices: []
    wrongAnswerResponse: I'm sorry.
  - speakerName: clown
    portrait: {fileID: 21300000, guid: a92bb00613b024542ba7d490c6cf22ba, type: 3}
    dialogue: Tonight's shows all wrapped up and people are headed out.
    hasChoices: 0
    choices: []
    wrongAnswerResponse: I'm sorry.
  - speakerName: clown
    portrait: {fileID: 21300000, guid: a92bb00613b024542ba7d490c6cf22ba, type: 3}
    dialogue: 'But I sense that someone special is still here, someone that we must
      recruit. '
    hasChoices: 0
    choices: []
    wrongAnswerResponse: I'm sorry.
  - speakerName: clown
    portrait: {fileID: 21300000, guid: a92bb00613b024542ba7d490c6cf22ba, type: 3}
    dialogue: There might be clues around to help you find the right person!
    hasChoices: 0
    choices: []
    wrongAnswerResponse: I'm sorry.
  - speakerName: clown
    portrait: {fileID: 21300000, guid: a92bb00613b024542ba7d490c6cf22ba, type: 3}
    dialogue: Let's go find our first member!
    hasChoices: 0
    choices: []
